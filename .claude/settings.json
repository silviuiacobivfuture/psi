{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"worktree": {
		"baseRef": "head"
	},
	"env": {
		"NX_DAEMON": "false"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-concurrency-guard.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"deny": [
			"Read(/apps/eqsync-web/**)",
			"Read(apps/eqsync-web/**)",
			"Read(/gitops/services/eqsync-web/**)",
			"Read(gitops/services/eqsync-web/**)",
			"Edit(/apps/eqsync-web/**)",
			"Edit(apps/eqsync-web/**)",
			"Edit(/gitops/services/eqsync-web/**)",
			"Edit(gitops/services/eqsync-web/**)"
		]
	}
}
