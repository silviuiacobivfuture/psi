{
	"name": "@psi/scheduling-tools",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "psi's scheduling operations: derive the Convex admin key, reconcile the store's authorization tuples into OpenFGA, and apply a clinic's rooms and organisation from its seed",
	"scripts": {
		"reconcile-authz": "tsx reconcile-authz/main.ts",
		"reseed-roles": "tsx reseed-roles/main.ts",
		"apply-rooms": "tsx apply-org/main.ts --only rooms",
		"apply-org": "tsx apply-org/main.ts",
		"type-check": "tsc --noEmit",
		"test": "vitest run --maxWorkers=2"
	},
	"dependencies": {
		"@psi/scheduling": "workspace:*",
		"@psi/scheduling-api": "workspace:*",
		"@psi/scheduling-sdk": "workspace:*",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	}
}
