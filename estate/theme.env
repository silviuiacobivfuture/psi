# psi's look, as SEB's builds take it (tools/estate-repo.mjs paints the sign-in from it; the brand
# generators in SEB's packages/rmx-ui/scripts read the same keys). Paths are from this repository's
# root. Every key is required: SEB has no default estate and stops, naming the key, when one is
# missing.
ESTATE_CONFIG=brand/estate.config.json
ESTATE_STYLESHEET=brand/estate.css
HUB_CLIENTS_FILE=estate/seb-components/autorizare/hub/clients.json
AUTHZ_MODEL_MANIFEST=estate/authz/fga.mod
# Estate mode (estate/authz.json platform_dir): psi's fga.mod lists only psi's modules; the sign-in
# painter reads the platform's half (core, autorizare) first, from the installed bundle (SEB 7b90d368).
AUTHZ_PLATFORM_MANIFEST=.seb-bundle/authz/platform.fga.mod
ESTATE_APP_DIRS=polaris=brand
# psi's own look on its sign-in (Authentik), from psi's design system.
SIGNIN_THEME=brand/signin-theme.json
