				"en": "Confirms, declines and cancels requests; keeps the hours and exceptions."
			},
			"scope_type": "platform",
			"relation": "role_cms_calendar_manager",
			"grants": ["cms_brand#read", "cms_brand#calendar_viewer", "cms_brand#calendar_manager"],
			"assignable": true,
			"max_duration": null
		},
