			"name": {
				"ro": "Responsabil cu protecția datelor",
				"en": "Privacy officer"
			},
			"description": {
				"ro": "Caută conturi, vede consimțămintele, face export și ștergere în numele persoanei; fiecare vizualizare se jurnalizează.",
				"en": "Looks up accounts, sees consents, exports and erases on the person's behalf; every view is logged."
