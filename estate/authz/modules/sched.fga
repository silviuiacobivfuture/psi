type sched_register
  relations
    define role_sched_integration: [user, group#member, sched_program]
    define parent_org: [org]
    define reader: [user] or role_sched_integration from parent_org or role_sched_integration
    define writer: [user] or role_sched_integration from parent_org or role_sched_integration
    # app_sched_access: what a person holds in this module, for the directory's tile policy (gen/app_access.py). Confers nothing.
    define app_sched_access: role_sched_integration

# The module's roles, as relations somebody can actually hold.
extend type org
  relations
    define role_sched_integration: [user, group#member]
    define program_sched: [sched_program]
    # app_sched_access: what a person holds in this module, for the directory's tile policy (gen/app_access.py). Confers nothing.
    define app_sched_access: role_sched_integration

# The module's roles, as relations somebody can actually hold.
extend type platform
  relations
    define role_sched_app_admin: [user, group#member]
    # app_sched_access: what a person holds in this module, for the directory's tile policy (gen/app_access.py). Confers nothing.
    define app_sched_access: role_sched_app_admin or administrator
