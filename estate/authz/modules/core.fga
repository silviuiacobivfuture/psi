module core

# Core types are UNPREFIXED and reserved to this module. Every other module
# prefixes its types with the module name (brs_order, sign_document) because
# OpenFGA does NOT namespace types by module — two modules defining `document`
# silently merge into one type with merged relations. @rule AUTZ-1.

type user

type group
  relations
    # Nested groups: a group may contain another group's members.
    define member: [user, group#member]

# The platform itself. Exactly one instance per store: `platform:<estate>`.
type platform
  relations
    # An open break-glass window CONFERS administration (owner decision D1,
    # 2026-10-27, "fix it properly"): `break_glass` is a time-bound tuple
    # (`non_expired_grant`, autorizare.fga), so the elevation ends by itself when
    # the window does. Before this, opening break-glass wrote a tuple no relation
    # read — the escape hatch opened and changed nothing (audit PA2). It does NOT
    # confer `grantor` below: handing out estate-wide power stays a separate act.
    # Consequence: every Check that can reach this relation passes `now` in its
    # context, or a holder's check errors instead of deciding.
    define administrator: [user, group#member] or break_glass
    define auditor: [user, group#member] or administrator
    # Who may release a new authorization model version. Held by CI.
    define model_releaser: [user, group#member] or administrator
    # GRANT AUTHORITY AT THE ESTATE SCOPE. @rule AUTZ-2 — meta-authorization
    # checks `grantor` on the scope owning the object being granted, so a scope
    # without one can hold roles that are written down and can never be given to
    # anybody. Three were: `autorizare:proprietar_modul`,
    # `autorizare:acces_urgenta`, and an estate signing application's `super_admin`, which could not
    # even be DECLARED — `check-manifest.py` refused it, correctly, at
    # declaration time.
    #
    # Deliberately NARROWER than `org#grantor`, which reads
    # `administrator or administrator from parent_platform`. There is nothing
    # above the platform to inherit from, so this is the top of the chain: it is
    # granted to a named subject and is NOT implied by `administrator`. An estate
    # administrator administers; handing out estate-wide power is a separate act
    # somebody is given on purpose, and the tests assert exactly that separation
    # (D-I, 2026-09-22).
    define grantor: [user, group#member]

# A tenant of a business application — an accounting firm, a partner.
# Distinct from autorizare_tenant, which is a tenant of the CONTROL PLANE.
type org
  relations
    define parent_platform: [platform]
    define administrator: [user, group#member]
    define member: [user, group#member] or administrator
    # GRANT AUTHORITY. Meta-authorization checks THIS relation, on the scope
    # that owns the object being granted. @rule AUTZ-2 — every scope type must
    # define `grantor`, or nothing can be granted on the objects it owns.
    define grantor: administrator or administrator from parent_platform
    define auditor: [user, group#member] or administrator or auditor from parent_platform
