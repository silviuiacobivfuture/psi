{
	"name": "@psi/ui",
	"version": "0.19.0",
	"private": true,
	"type": "module",
	"description": "psi's component library: typed server-rendered TSX (hono/jsx), Datastar for behaviour, styled by the psi design language",
	"exports": {
		".": "./src/index.ts",
		"./components.css": "./src/components.css",
		"./datastar.js": "./assets/datastar.js",
		"./effects.css": "./src/effects.css",
		"./mobile.css": "./src/mobile.css",
		"./compass.css": "./src/compass.css",
		"./brand-eqsync.css": "./src/brand-eqsync.css",
		"./brand-hemisync.css": "./src/brand-hemisync.css",
		"./brand-blog.css": "./src/brand-blog.css",
		"./flat.css": "./src/flat.css",
		"./inbox.css": "./src/notifications/inbox.css",
		"./timeline.css": "./src/timeline.css",
		"./imagery.css": "./src/imagery.css",
		"./testing": "./src/testing.ts",
		"./admin": "./src/admin/index.ts",
		"./admin.css": "./src/admin/admin.css",
		"./staff-assistant": "./src/staff-assistant/index.ts",
		"./staff-assistant.css": "./src/staff-assistant/staff-assistant.css",
		"./admin/floor-plan": "./src/floor-plan/index.ts",
		"./floor-plan.css": "./src/floor-plan/floor-plan.css"
	},
	"scripts": {
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"build:client": "node scripts/build-client.ts && node scripts/build-floor-plan.ts",
		"build:staff-client": "node scripts/build-staff-client.ts",
		"build:client:check": "node scripts/build-client.ts --check && node scripts/build-floor-plan.ts --check && node scripts/build-staff-client.ts --check"
	},
	"dependencies": {
		"@psi/content": "workspace:*",
		"@psi/design": "workspace:*",
		"@psi/engine": "workspace:*",
		"@psi/guide": "workspace:*",
		"zod": "^3.25.76"
	},
	"peerDependencies": {
		"hono": "^4.13.0"
	},
	"devDependencies": {
		"axe-core": "4.10.3",
		"happy-dom": "20.14.6",
		"hono": "^4.13.18",
		"typescript": "^5.7.3",
		"vitest": "^2.1.9",
		"esbuild": "^0.25.0"
	}
}
