#!/usr/bin/env sh
# The message rule (conventional commit + [PATCH]/[UPDATE]/[RELEASE]), the changelog rule (a
# business-facing commit to apps/<app>/ carries its Changelog trailer; CLAUDE.md "Changelog"), then the bump: every
# package that owns a staged file has its version bumped into THIS commit (post-commit folds it).
node scripts/commit-msg.mjs "$1" || exit 1
node scripts/changelog-trailer.mjs "$1" || exit 1
node scripts/version-bump.mjs "$1" || exit 1
