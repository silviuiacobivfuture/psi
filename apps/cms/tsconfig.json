{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"noEmit": true,
		"allowJs": true,
		"incremental": true,
		"declaration": false,
		"declarationMap": false,
		"noUncheckedIndexedAccess": true,
		"plugins": [{ "name": "next" }],
		"paths": { "@payload-config": ["./src/payload.config.ts"] }
	},
	"include": ["next-env.d.ts", "src", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next"]
}
