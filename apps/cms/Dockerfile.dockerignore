# The build context is the repository root; this keeps it to what the build reads.
**/node_modules
**/.next
**/dist
.nx
.git
.env
**/.env
**/.env.*
**/.data
# .seb-bundle is NOT ignored: the image installs from it. CI installs the locked bundle before
# the build (.github/actions/seb-bundle), so pnpm install inside finds it current and fetches nothing.
