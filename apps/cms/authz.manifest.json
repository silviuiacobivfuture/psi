{
	"$comment": "The psi CMS (apps/cms). Permissions are decided per brand: object cms_brand:<psizone|eqsync|hemisync|blog> (one admin for the four sites). The CMS asks Check(user:<sub>, <relation>, cms_brand:<brand>) and ListObjects(cms_brand, <relation>) and stores no role. Until psi's OpenFGA is reachable from the CMS, src/authz/interim.ts evaluates these same roles from CMS_ROLE_ASSIGNMENTS (docs/plans/blog-platform.md).",
	"app": "cms",
	"module": "cms",
	"version": 1,
	"features": [
		{
			"key": "content",
			"name": {
				"ro": "Conținut",
				"en": "Content"
			},
			"permissions": [
				{
					"key": "read",
					"name": {
						"ro": "Citește conținutul, inclusiv ciornele",
						"en": "Read content, drafts included"
					},
					"grants": ["cms_brand#read"],
					"effect": "read"
				},
				{
					"key": "write",
					"name": {
						"ro": "Scrie și modifică ciorne",
						"en": "Write and edit drafts"
					},
					"grants": ["cms_brand#write"],
					"effect": "write"
				},
				{
					"key": "publish",
					"name": {
						"ro": "Publică (doar conținut aprobat clinic)",
						"en": "Publish (clinically approved content only)"
					},
					"grants": ["cms_brand#publish"],
					"effect": "write"
				}
			]
		},
		{
			"key": "review",
			"name": {
				"ro": "Revizuire clinică",
				"en": "Clinical review"
			},
			"permissions": [
				{
					"key": "clinical_review",
					"name": {
						"ro": "Aprobă sau respinge textul altcuiva",
						"en": "Approve or reject someone else's text"
					},
					"grants": ["cms_brand#clinical_review"],
					"effect": "write"
				}
			]
		},
		{
			"key": "media",
			"name": {
				"ro": "Media",
				"en": "Media"
			},
			"permissions": [
				{
					"key": "manage_media",
					"name": {
						"ro": "Încarcă și gestionează imagini",
						"en": "Upload and manage images"
					},
					"grants": ["cms_brand#manage_media"],
					"effect": "write"
				}
			]
		},
		{
			"key": "admin",
			"name": {
				"ro": "Administrare",
				"en": "Administration"
			},
			"permissions": [
				{
					"key": "admin",
					"name": {
						"ro": "Șterge conținut, vede persoanele",
						"en": "Delete content, see people"
					},
					"grants": ["cms_brand#admin"],
					"effect": "write"
				}
			]
		},
		{
			"key": "ai",
			"name": {
				"ro": "Setări AI",
				"en": "AI settings"
			},
			"permissions": [
				{
					"key": "ai_admin",
					"name": {
						"ro": "Schimbă setările AI ale brandului (încorporări, căutare, ghid)",
						"en": "Change the brand's AI settings (embeddings, search, guide)"
					},
					"grants": ["cms_brand#ai_admin"],
					"effect": "write"
				}
			]
		},
		{
			"key": "platform",
			"name": {
				"ro": "Platformă",
				"en": "Platform"
			},
			"permissions": [
				{
					"key": "ai_operator",
					"name": {
						"ro": "Operează ghidul: reindexează cunoștințele, pune o întrebare de test",
						"en": "Operate the guide: rebuild the knowledge index, ask a test question"
					},
					"grants": ["cms_brand#ai_operator"],
					"effect": "write"
				},
				{
					"key": "calendar_viewer",
					"name": {
						"ro": "Vede calendarul: practicieni, servicii, program, cereri",
						"en": "See the calendar: practitioners, services, hours, requests"
					},
					"grants": ["cms_brand#calendar_viewer"],
					"effect": "read"
				},
				{
					"key": "calendar_manager",
					"name": {
						"ro": "Gestionează calendarul: confirmă, refuză, anulează, program și excepții",
						"en": "Manage the calendar: confirm, decline, cancel, hours and exceptions"
					},
					"grants": ["cms_brand#calendar_manager"],
					"effect": "write"
				},
				{
					"key": "privacy_officer",
					"name": {
						"ro": "Responsabil cu datele: caută conturi, consimțăminte, export și ștergere",
						"en": "Privacy officer: look up accounts, consents, export and erasure"
					},
					"grants": ["cms_brand#privacy_officer"],
					"effect": "write"
				},
				{
					"key": "notifications_admin",
					"name": {
						"ro": "Notificări: statistici și trimiterea unui test",
						"en": "Notifications: statistics and sending a test"
					},
					"grants": ["cms_brand#notifications_admin"],
					"effect": "write"
				},
				{
					"key": "site_manager",
					"name": {
						"ro": "Setările sitului: telefoane, adrese, program, rețele, comutatoare",
						"en": "Site settings: phones, addresses, hours, social links, toggles"
					},
					"grants": ["cms_brand#site_manager"],
					"effect": "write"
				}
			]
		}
	],
	"objects": [
		{
			"type": "cms_brand",
			"scope": {
				"scope_type": "platform",
				"relation": "parent_platform"
			},
			"relations": [
				{
					"name": "parent_platform",
					"from": ["[platform]"]
				},
				{
					"name": "read",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "write",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "publish",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "clinical_review",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "manage_media",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "admin",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "ai_admin",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "ai_operator",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "calendar_viewer",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "calendar_manager",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "privacy_officer",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "notifications_admin",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				},
				{
					"name": "site_manager",
					"from": ["[user, group#member]", "administrator from parent_platform"]
				}
			]
		}
	],
	"roles": [
		{
			"key": "cms:admin",
			"name": {
				"ro": "Administrator CMS",
				"en": "CMS administrator"
			},
			"description": {
				"ro": "Tot ce poate face CMS-ul și panoul de control, pe toate brandurile.",
				"en": "Everything the CMS and the control plane do, on every brand."
			},
			"scope_type": "platform",
			"super_admin": true,
			"grants": [
				"cms_brand#read",
				"cms_brand#write",
				"cms_brand#publish",
				"cms_brand#clinical_review",
				"cms_brand#manage_media",
				"cms_brand#admin",
				"cms_brand#ai_admin",
				"cms_brand#ai_operator",
				"cms_brand#calendar_viewer",
				"cms_brand#calendar_manager",
				"cms_brand#privacy_officer",
				"cms_brand#notifications_admin",
				"cms_brand#site_manager"
			],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:editor",
			"name": {
				"ro": "Editor",
				"en": "Editor"
			},
			"description": {
				"ro": "Scrie ciorne și încarcă imagini; nu publică.",
				"en": "Writes drafts and uploads images; does not publish."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#write", "cms_brand#manage_media"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:publisher",
			"name": {
				"ro": "Publicator",
				"en": "Publisher"
			},
			"description": {
				"ro": "Publică conținutul aprobat.",
				"en": "Publishes approved content."
			},
			"scope_type": "platform",
			"grants": [
				"cms_brand#read",
				"cms_brand#write",
				"cms_brand#publish",
				"cms_brand#manage_media"
			],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:clinical_reviewer",
			"name": {
				"ro": "Revizor clinic",
				"en": "Clinical reviewer"
			},
			"description": {
				"ro": "Aprobă sau respinge, pe fiecare limbă, textul clinic scris de altcineva.",
				"en": "Approves or rejects, per language, clinical text someone else wrote."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#clinical_review"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:reader",
			"name": {
				"ro": "Cititor (serviciu)",
				"en": "Reader (service)"
			},
			"description": {
				"ro": "Citește ciornele, fără a scrie: blogul de staging și previzualizarea.",
				"en": "Reads drafts without writing: the staging blog and the preview."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:ai_admin",
			"name": {
				"ro": "Administrator AI",
				"en": "AI administrator"
			},
			"description": {
				"ro": "Schimbă setările AI ale brandului și operează ghidul; citește conținutul.",
				"en": "Changes the brand's AI settings and operates the guide; reads content."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#ai_admin", "cms_brand#ai_operator"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:ai_operator",
			"name": {
				"ro": "Operator AI",
				"en": "AI operator"
			},
			"description": {
				"ro": "Reindexează cunoștințele și pune întrebări de test; nu schimbă setările.",
				"en": "Rebuilds the knowledge index and asks test questions; does not change settings."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#ai_operator"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:calendar_viewer",
			"name": {
				"ro": "Recepție (vizualizare)",
				"en": "Reception (view)"
			},
			"description": {
				"ro": "Vede calendarul și cererile, fără a decide.",
				"en": "Sees the calendar and the requests, without deciding."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#calendar_viewer"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:calendar_manager",
			"name": {
				"ro": "Recepție",
				"en": "Reception"
			},
			"description": {
				"ro": "Confirmă, refuză și anulează cereri; ține programul și excepțiile.",
				"en": "Confirms, declines and cancels requests; keeps the hours and exceptions."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#calendar_viewer", "cms_brand#calendar_manager"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:privacy_officer",
			"name": {
				"ro": "Responsabil cu protecția datelor",
				"en": "Privacy officer"
			},
			"description": {
				"ro": "Caută conturi, vede consimțămintele, face export și ștergere în numele persoanei; fiecare vizualizare se jurnalizează.",
				"en": "Looks up accounts, sees consents, exports and erases on the person's behalf; every view is logged."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#privacy_officer"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:notifications_admin",
			"name": {
				"ro": "Administrator notificări",
				"en": "Notifications administrator"
			},
			"description": {
				"ro": "Vede abonații și livrările; trimite o notificare de test sieși.",
				"en": "Sees subscribers and deliveries; sends a test notification to themselves."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#notifications_admin"],
			"assignable": true,
			"max_duration": null
		},
		{
			"key": "cms:site_manager",
			"name": {
				"ro": "Administrator site",
				"en": "Site manager"
			},
			"description": {
				"ro": "Ține setările sitului: contact, program, rețele, comutatoare.",
				"en": "Keeps the site settings: contact, hours, social links, toggles."
			},
			"scope_type": "platform",
			"grants": ["cms_brand#read", "cms_brand#site_manager"],
			"assignable": true,
			"max_duration": null
		}
	],
	"group_bindings": [],
	"providers": {
		"identity": {
			"supported": ["authentik"],
			"selected": "authentik"
		},
		"authorization": {
			"supported": ["autorizare"],
			"selected": "autorizare"
		}
	},
	"public_reasons": [
		{
			"key": "sign_in",
			"description": {
				"ro": "Intrarea: /api/users/oauth/authorize și /api/users/oauth/callback (Authentik).",
				"en": "Signing in: /api/users/oauth/authorize and /api/users/oauth/callback (Authentik)."
			}
		},
		{
			"key": "health_probe",
			"description": {
				"ro": "/healthz răspunde fără date.",
				"en": "/healthz answers with no data."
			}
		},
		{
			"key": "published_content",
			"description": {
				"ro": "Siturile citesc anonim doar conținutul publicat (și aprobat clinic).",
				"en": "The sites read only published (and clinically approved) content anonymously."
			}
		},
		{
			"key": "analytics_ingest",
			"description": {
				"ro": "/api/analytics/ingest primește contoare zilnice doar cu cheia colectorului blogului.",
				"en": "/api/analytics/ingest takes daily counters only with the blog collector's key."
			}
		},
		{
			"key": "control_plane_staff",
			"description": {
				"ro": "/api/platform/staff răspunde doar unei cereri semnate de un site (PSI_CONTROL_SECRET).",
				"en": "/api/platform/staff answers only a request a site signed (PSI_CONTROL_SECRET)."
			}
		}
	]
}
