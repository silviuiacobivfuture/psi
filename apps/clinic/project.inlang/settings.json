{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "ro",
	"locales": ["ro", "en"],
	"modules": ["https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4.4.0/dist/index.js"],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/{locale}.json",
			"./messages/pwa/{locale}.json",
			"./messages/appointments/{locale}.json",
			"./messages/shell/{locale}.json",
			"./messages/audit/{locale}.json",
			"./messages/stats/{locale}.json",
			"./messages/profile/{locale}.json",
			"./messages/settings/{locale}.json",
			"./messages/members/{locale}.json",
			"./messages/client/{locale}.json",
			"./messages/roles/{locale}.json"
		]
	}
}
