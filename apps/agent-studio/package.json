{
	"name": "@psi/agent-studio",
	"version": "0.2.1",
	"private": true,
	"type": "module",
	"description": "Mastra Studio for psi's guides, deployed for staff at studio.psizone.ro behind the estate's Authentik gate, read-only unless the caller may operate",
	"scripts": {
		"build": "MASTRA_TELEMETRY_DISABLED=1 mastra build --dir src/mastra --studio",
		"start": "node .mastra/output/index.mjs",
		"type-check": "tsc --noEmit",
		"test": "vitest run --maxWorkers=2"
	},
	"dependencies": {
		"@mastra/core": "^1.82.0",
		"@mastra/libsql": "^1.29.0",
		"@psi/account": "workspace:*",
		"@psi/guide": "workspace:*",
		"@psi/knowledge": "workspace:*",
		"jose": "^6.2.17",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"hono": "^4.13.18",
		"mastra": "1.38.0",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	}
}
