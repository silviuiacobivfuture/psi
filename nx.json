{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "dev",
	"useDaemonProcess": false,
	"parallel": 3,
	"cacheDirectory": ".nx/cache",
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": [
			"default",
			"!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
			"!{projectRoot}/tsconfig.spec.json"
		],
		"sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/estate/platform.lock"]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"],
			"outputs": ["{projectRoot}/dist/**", "{projectRoot}/.next/**", "{projectRoot}/build/**"],
			"cache": true
		},
		"test": { "cache": true },
		"type-check": { "dependsOn": ["^build"], "cache": true },
		"lint": { "cache": true }
	}
}
