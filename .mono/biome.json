{
	"$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!pnpm-lock.yaml",
			"!**/dist/**",
			"!**/*.generated.*",
			"!.mono/**",
			"!**/node_modules/**",
			"!pieces/**",
			"!gitops/**",
			"!components/**"
		],
		"experimentalScannerIgnores": [
			".mono"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "error"
			}
		}
	}
}
